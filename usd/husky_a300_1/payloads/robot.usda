#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    defaultPrim = "tn__a30000000_pD"
    doc = """Generated from Composed Stage of root layer /tmp/tmpybrlg0kp/a300-00000.usdc


Generated from Composed Stage of root layer /home/anushri/husky_assignment/usd/_debug_husky_a300/usdex_husky_a300_1/a300-00000.usdc


Generated from Composed Stage of root layer /home/anushri/husky_assignment/usd/_debug_husky_a300/temp_husky_a300_1/husky_a300.usd
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "tn__a30000000_pD" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </tn__a30000000_pD/Physics/front_left_wheel_joint>,
        </tn__a30000000_pD/Physics/front_right_wheel_joint>,
        </tn__a30000000_pD/Physics/rear_left_wheel_joint>,
        </tn__a30000000_pD/Physics/rear_right_wheel_joint>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </tn__a30000000_pD/Geometry/base_link>,
        </tn__a30000000_pD/Geometry/base_link/front_left_wheel_link>,
        </tn__a30000000_pD/Geometry/base_link/front_right_wheel_link>,
        </tn__a30000000_pD/Geometry/base_link/rear_left_wheel_link>,
        </tn__a30000000_pD/Geometry/base_link/rear_right_wheel_link>,
    ]
    token isaac:robotType = "Default"

    over "Geometry"
    {
        over "base_link" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "front_left_wheel_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "front_right_wheel_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "rear_left_wheel_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "rear_right_wheel_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }
        }
    }

    over "Physics"
    {
        over "front_left_wheel_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "front_right_wheel_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "rear_left_wheel_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "rear_right_wheel_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }
}

